{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "rumboapp",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "rumboapp (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "rumboapp (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "rumboapp (debug mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "toolArgs": [
                "--dart-define-from-file=dart_defines.json"
            ]
        },
        {
            "name": "Rumbo Web (debug)",
            "request": "launch",
            "type": "dart",
            "program": "${workspaceFolder}/lib/main.dart",
            "deviceId": "chrome",
            "flutterMode": "debug",
            "toolArgs": [
                "--dart-define-from-file=dart_defines.json"
            ]
        }    
    ]
}